# Tambahkan blok ini ke /etc/caddy/Caddyfile, ganti api.example.com dengan subdomainmu,
# lalu: sudo systemctl reload caddy
# Caddy mengurus sertifikat HTTPS otomatis (DNS subdomain harus sudah mengarah ke server).
api.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3001 {
		# SSE (/api/events) harus langsung diteruskan, tanpa buffer
		flush_interval -1
	}
}
