# Salin ke apps/server/.env lalu isi.

NODE_ENV=development
# 127.0.0.1 di produksi (di belakang Caddy). 0.0.0.0 agar bisa diakses HP di jaringan yang sama saat development.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Sesuai docker-compose.yml di root repo
DATABASE_URL=postgres://catetin:catetin_dev@127.0.0.1:5432/catetin

# Buat dengan: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL publik server, mis. https://api.domainmu.com (development: http://localhost:3001)
BETTER_AUTH_URL=http://localhost:3001
# Origin tambahan yang dipercaya, dipisah koma (scheme aplikasi mobile)
TRUSTED_ORIGINS=catetin://

# Satu-satunya akun yang bisa login. Dibuat otomatis saat server pertama kali jalan.
OWNER_EMAIL=
OWNER_NAME=Najmi

# Akun Gmail: IMAP untuk email Mandiri, SMTP untuk kode login.
# Tanpa ini (development), kode login hanya dicetak di log server.
EMAIL=
EMAIL_PASSWORD=

GMAIL_ENABLED=false
GMAIL_POLL_INTERVAL_MS=60000

WA_ENABLED=false
WA_AUTH_DIR=./data/auth_session
MY_LID=
MY_PHONE=
